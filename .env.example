# Banco de dados (Supabase, Neon ou qualquer Postgres)
# DATABASE_URL usa o pooler e é o que a aplicação consome no dia a dia.
# DIRECT_URL é a conexão direta, usada apenas pelas migrações do Prisma.
# Se a conexão direta recusar por causa de IPv4, use o endereço do
# "Session pooler" do Supabase como DIRECT_URL. As migrações funcionam igual.
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# Segredo usado para assinar o cookie de sessão.
# Gere um valor longo e aleatório. Nunca reaproveite entre ambientes.
SESSAO_SEGREDO="troque-por-um-valor-aleatorio-de-no-minimo-32-caracteres"

# Armazenamento das imagens e anexos (Supabase Storage, com balde privado)
#
# Use a chave SECRETA do projeto, chamada "secret key" (sb_secret_...) nos
# projetos novos ou "service_role" nos antigos. Ela fica apenas no servidor.
#
# Nunca use a chave publicável, nem crie variáveis com o prefixo
# NEXT_PUBLIC_: tudo que tem esse prefixo é entregue ao navegador.
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="chave-secreta-do-supabase"
SUPABASE_BUCKET="anexos"

# Primeiro administrador, criado pelo comando de semeadura
ADMIN_NOME="Administrador"
ADMIN_USUARIO="admin"
ADMIN_SENHA="defina-uma-senha-forte"
